{
  "name": "ctm-aserdargun-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cell to Mind — Life evolves. Minds emerge. Tarayicida calisan 3B bilimsel ekosistem simülasyonu.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "experiments": "vite-node scripts/run-experiments.ts",
    "experiments:quick": "vite-node scripts/run-experiments.ts --quick",
    "server": "node server/index.ts",
    "assets:build": "/Applications/Blender.app/Contents/MacOS/Blender -b --python scripts/blender/make_assets.py",
    "check": "npm run typecheck && npm run test && npm run e2e && npm run calibrate",
    "calibrate": "vite-node tools/calibrate-niche-axes.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-node": "6.0.0",
    "vitest": "5.0.3"
  }
}
